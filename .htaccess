DirectoryIndex index.php index.html miniapp/app.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Auto-redirect root domain access (ordering.kaldisbunnaet.com/) to /eca/
    RewriteCond %{REQUEST_URI} ^/$ [OR]
    RewriteCond %{REQUEST_URI} ^/index\.php$
    RewriteRule ^(.*)$ /eca/ [R=302,L]

    # Direct requests to existing files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>

<Files 403.shtml>
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        order allow,deny
        allow from all
    </IfModule>
</Files>
